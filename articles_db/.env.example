# Example Environment Configuration
# Copy this file to .env and modify the values as needed

# PostgreSQL Database Configuration
POSTGRES_DB=articles_db
POSTGRES_USER=articles_user
POSTGRES_PASSWORD=your_secure_password_here

# Database Connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Adminer Configuration (Database Management Interface)
ADMINER_PORT=8080

# Optional: Connection String Template
# DATABASE_URL=postgresql://articles_user:your_secure_password_here@localhost:5432/articles_db