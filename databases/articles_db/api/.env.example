# Environment variables for Articles Analytics API
# Copy this file to .env and update with your values

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=articles_db
DB_USER=postgres
DB_PASSWORD=postgres123

# API Configuration
API_TITLE=Articles Analytics API
API_VERSION=1.0.0
API_DESCRIPTION=Backend API for Taxi Drivers content analytics

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=500
